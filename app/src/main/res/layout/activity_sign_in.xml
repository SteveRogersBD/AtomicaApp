<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.SignInActivity">

    <!-- Chemistry Lab Background Image - Full Visibility -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/chem"
        android:alpha="1.0" />

    <!-- Light Overlay for Text Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/lighter_lab_overlay" />


    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- Top Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5" />

            <!-- Logo Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="40dp">

                <!-- Atomica Logo with Enhanced Glow -->
                <FrameLayout
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginBottom="20dp">

                    <!-- Multi-layer Glow Effect -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/enhanced_logo_glow" />

                    <!-- Logo Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="16dp"
                        app:cardBackgroundColor="#CC000000"
                        app:strokeColor="#FF39FF14"
                        app:strokeWidth="3dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/logo_sign_in"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center"
                            android:src="@drawable/beaker"
                            app:civ_border_color="#FF39FF14"
                            app:civ_border_width="2dp" />

                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <!-- App Name with Neon Effect -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="ATOMICA"
                    android:textColor="#FF39FF14"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:fontFamily="monospace"
                    android:shadowColor="#FF39FF14"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10" />

                <!-- Enhanced Tagline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="MOLECULAR RESEARCH LAB"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <!-- Welcome Text -->
                <TextView
                    android:id="@+id/ht_sign_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Access Laboratory Database"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:alpha="0.9" />

            </LinearLayout>

            <!-- Laboratory Access Panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#B3000000"
                app:cardCornerRadius="24dp"
                app:cardElevation="20dp"
                app:strokeColor="#FF39FF14"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <!-- Lab Access Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="LABORATORY ACCESS TERMINAL"
                            android:textColor="#FF39FF14"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                    </LinearLayout>
                    <!-- Researcher ID Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:boxBackgroundColor="#FF2E3B4E"
                        app:boxStrokeColor="#FF39FF14"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email_sign_in"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="🧪 Researcher ID"
                            android:inputType="textEmailAddress"
                            android:textColor="#FFFFFFFF"
                            android:textColorHint="#CC39FF14"
                            android:background="@drawable/input_field_background" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Security Clearance Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxBackgroundColor="#FF2E3B4E"
                        app:boxStrokeColor="#FF39FF14"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_sign_in"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="🔐 Security Clearance Code"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFFFF"
                            android:textColorHint="#CC39FF14"
                            android:background="@drawable/input_field_background" />
                    </com.google.android.material.textfield.TextInputLayout>



                    <!-- Forgot Clearance -->
                    <TextView
                        android:id="@+id/forgot_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="end"
                        android:padding="8dp"
                        android:text="Request Clearance Reset"
                        android:textColor="#FF39FF14"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Access Lab Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sign_in_btn_sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="20dp"
                        android:text="ACCESS LABORATORY"
                        android:textColor="#FF000000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        app:backgroundTint="#FF39FF14"
                        app:cornerRadius="30dp"
                        app:elevation="8dp" />

                    <!-- Molecular Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/neon_line" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="⚛️"
                            android:textSize="20sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/neon_line" />

                    </LinearLayout>

                    <!-- Alternative Access Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/google_btn_sign_in"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🌐 External Research Access"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        app:cornerRadius="28dp"
                        app:icon="@drawable/google"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@null"
                        app:strokeColor="#FF39FF14"
                        app:strokeWidth="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Research Registration Link -->
            <LinearLayout
                android:id="@+id/bottom_linear_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp"
                android:transitionName="linear_anim">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧬 New Researcher? "
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/sign_up_tv_sign_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register for Lab Access"
                    android:textColor="#FF39FF14"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Bottom Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>