<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    app:cardElevation="8dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/colorPrimaryVariant"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorSecondary"
    android:layout_margin="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- News Image with Gradient Overlay -->
        <ImageView
            android:id="@+id/poster_news"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_alignParentTop="true"
            android:scaleType="centerCrop"
            android:contentDescription="News Image"
            android:background="@color/colorPrimary" />

        <!-- Gradient Overlay for better text readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignBottom="@id/poster_news"
            android:background="@drawable/gradient_overlay" />

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/poster_news"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/colorPrimaryVariant">

            <!-- News Title -->
            <TextView
                android:id="@+id/caption_news"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Breaking: Revolutionary Farming Technology Increases Crop Yields by 300%"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <!-- Publication Date with Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/published_at_news"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 31, 2024"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium" />

                <!-- Optional: Add a small dot separator and category -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_separator" />

                <TextView
                    android:id="@+id/category_news"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agriculture"
                    android:textColor="@color/colorSecondaryVariant"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>