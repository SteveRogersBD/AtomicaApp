<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:padding="8dp">

    <!-- Bot avatar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#FF2E3B4E"
        app:strokeColor="#FF39FF14"
        app:strokeWidth="1dp"
        app:cardElevation="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/beaker"
            android:tint="#FF39FF14" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="64dp">

        <!-- Bot name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="4dp"
            android:text="ATOMICA AI"
            android:textColor="#FF39FF14"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- Bot message bubble -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#B3000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#FF39FF14"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:maxWidth="280dp"
                android:text="Hello! I'm ATOMICA AI, your chemistry research assistant. How can I help you today?" />
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
</LinearLayout>