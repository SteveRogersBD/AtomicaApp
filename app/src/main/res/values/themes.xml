<resources>
    <!-- App theme: Material3 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- brand colors (use your existing brand values) -->
        <item name="colorPrimary">#1A2526</item>
        <item name="colorSecondary">#39FF14</item>
        <item name="colorTertiary">#2ECC71</item>

        <!-- surfaces / backgrounds -->
        <item name="colorSurface">#2E3B4E</item>
        <item name="android:statusBarColor">#2E3B4E</item>
        <item name="android:navigationBarColor">#1A2526</item>

        <!-- optional: use color scheme automatically -->
        <!-- <item name="material3DynamicColorApplied">false</item> -->

        <!-- Buttons use our custom Material3 button style -->
        <item name="materialButtonStyle">@style/Widget.Atomica.Button</item>
    </style>

    <!-- Material3 button style (do NOT set android:background; use tints) -->
    <style name="Widget.Atomica.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="backgroundTint">#39FF14</item>
        <item name="cornerRadius">30dp</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Text appearances (Material3) -->
    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Optional: a reusable TextInputLayout style -->
    <style name="Widget.Atomica.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">#FF2E3B4E</item>
        <item name="boxStrokeColor">#FF39FF14</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
    </style>
</resources>
